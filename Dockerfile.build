# Docker image for building DDM binary on CentOS 7.9 (glibc 2.17)
#
# Build (Apple Silicon macOS add --platform):
#   docker build --platform linux/amd64 -t ddm-builder -f Dockerfile.build .
#
# Run:
#   docker run --platform linux/amd64 --rm -v $(pwd):/build ddm-builder
#
# Output: dist/ddm (standalone Linux ELF x86_64 binary)

FROM --platform=linux/amd64 centos:7.9.2009

ARG CACHE_BUST=1

# CentOS 7 is EOL — switch mirrors to vault
RUN sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*.repo \
    && sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo \
    && yum install -y \
        gcc \
        make \
        openssl-devel \
        bzip2-devel \
        libffi-devel \
        zlib-devel \
        wget \
    && yum clean all

# Build Python 3.9.16 from source (compatible with CentOS 7 OpenSSL 1.0.2)
RUN echo "Build v${CACHE_BUST}" \
    && wget -q https://www.python.org/ftp/python/3.9.16/Python-3.9.16.tgz \
    && tar xzf Python-3.9.16.tgz \
    && cd Python-3.9.16 \
    && ./configure --enable-shared --with-ensurepip=install \
    && make -j$(nproc) \
    && make altinstall \
    && cd .. && rm -rf Python-3.9.16*

RUN ln -sf /usr/local/bin/python3.9 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/pip3.9 /usr/local/bin/pip3 \
    && echo "/usr/local/lib" > /etc/ld.so.conf.d/python3.conf \
    && ldconfig

RUN echo "Install deps v${CACHE_BUST}" \
    && pip3 install --upgrade pip \
    && pip3 install pyinstaller \
    && pip3 install \
        click==8.1.3 \
        rich==12.6.0 \
        pydantic==1.10.2 \
        PyYAML==6.0 \
        loguru==0.6.0 \
        psutil==5.9.4 \
        blake3==0.3.2

ENV PATH="/usr/local/bin:$PATH"

WORKDIR /build

CMD ["/bin/bash", "-c", "\
    chmod +x build_binary.sh && \
    ./build_binary.sh && \
    echo '' && \
    echo '=== Binary compatibility ===' && \
    file dist/ddm && \
    echo '' && \
    echo 'Done.' \
"]
